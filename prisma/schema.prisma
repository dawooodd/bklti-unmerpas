// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enum: Role
// ============================================
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// ============================================
// Model: User (Tahap 11 & 17)
// Menyimpan data akun pengguna (Login & RBAC)
// ============================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  nim           String?   @unique
  prodi         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  events        Event[]
  modules       Module[]
  notifications Notification[]

  @@map("users")
}

// ============================================
// Model: NextAuth Adapters (Tahap 17)
// Dibutuhkan untuk integrasi SSO / NextAuth
// ============================================
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Model: Event (CMS - Kegiatan & Pelatihan)
// Dikelola oleh Admin melalui Content Manager
// ============================================
model Event {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  date        DateTime
  location    String?
  imageUrl    String?
  category    String   @default("KEGIATAN") // "KEGIATAN" | "PELATIHAN"
  isPublished Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// ============================================
// Model: Module (CMS - Materi & Modul)
// Dikelola oleh Admin melalui Content Manager
// ============================================
model Module {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String
  fileUrl     String
  isPublished Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("modules")
}

// ============================================
// Model: EventRegistration (Tahap 1)
// Menyimpan data pendaftaran acara/pelatihan (publik)
// ============================================
model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventSlug String
  nama      String
  nim       String
  instansi  String
  noWa      String
  createdAt DateTime @default(now())

  @@map("event_registrations")
}

// ============================================
// Model: HelpdeskTicket (Tahap 3)
// Menyimpan data tiket bantuan helpdesk
// ============================================
model HelpdeskTicket {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @unique
  nama         String
  emailOrNim   String
  kategori     String
  deskripsi    String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@map("helpdesk_tickets")
}

// ============================================
// Model: Document (Tahap 2)
// Menyimpan data materi/dokumen repositori (legacy)
// ============================================
model Document {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("documents")
}

// ============================================
// Model: Notification (Tahap 11)
// Menyimpan notifikasi akademik & pengumuman
// type: "SPP" | "UJIAN" | "SKRIPSI" | "YUDISIUM" | "WISUDA" | "PENGUMUMAN"
// targetRole: "ALL" | "MAHASISWA"
// ============================================
model Notification {
  id         Int      @id @default(autoincrement())
  type       String
  message    String
  targetRole String   @default("ALL")
  date       DateTime
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@map("notifications")
}
