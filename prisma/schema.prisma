// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// Model: EventRegistration (Tahap 1)
// Menyimpan data pendaftaran acara/pelatihan
// ============================================
model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventSlug String
  nama      String
  nim       String
  instansi  String
  noWa      String
  createdAt DateTime @default(now())

  @@map("event_registrations")
}

// ============================================
// Model: HelpdeskTicket (Tahap 3)
// Menyimpan data tiket bantuan helpdesk
// ============================================
model HelpdeskTicket {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @unique
  nama         String
  emailOrNim   String
  kategori     String
  deskripsi    String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@map("helpdesk_tickets")
}

// ============================================
// Model: Document (Tahap 2)
// Menyimpan data materi/dokumen repositori
// ============================================
model Document {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("documents")
}
